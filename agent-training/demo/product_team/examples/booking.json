{
  "name": "会议室预约",
  "requirements": "实现独立会议室预约产品，Python标准库与SQLite。GET /api/bookings 返回按id升序的数组。POST /api/bookings {room,start,end,owner} 创建预约，时间为同一日期UTC的ISO 8601字符串，room与owner不能为空、start严格早于end，否则400；201返回{id整数,room,start,end,owner}。同一room区间重叠返回409，相接的时间边界允许预约，不同room可同时间预约；并发重叠仅一个成功。DELETE /api/bookings/{id} 仅Authorization: Bearer admin可删除，无身份401，非admin403，成功204，记录不存在404。重启后保留预约及删除结果。测试角色是本地演练身份。前端标题包含预约，表单有#room、#start、#end、#owner文本输入，#book提交，#bookings列表和#error错误区，时间使用完整ISO文本；有管理员删除操作，提交后立即刷新，刷新后能看到持久数据。README说明启动、配置、测试身份、数据库备份与回滚。",
  "unresolved": [],
  "acceptance": [
    {"id":"empty_calendar","steps":[{"path":"/","expect":{"status":200,"contains":["预约","id=\"room\"","id=\"book\""]}},{"path":"/api/bookings","expect":{"status":200,"equals":[]}}]},
    {"id":"book_and_validate","steps":[{"path":"/api/bookings","method":"POST","body":{"room":"A","start":"2030-01-01T10:00:00Z","end":"2030-01-01T11:00:00Z","owner":"Alice"},"expect":{"status":201,"fields":{"room":"A","owner":"Alice","start":"2030-01-01T10:00:00Z","end":"2030-01-01T11:00:00Z"},"types":{"id":"integer"}},"save":{"booking":"id"}},{"path":"/api/bookings","method":"POST","body":{"room":"A","start":"2030-01-01T11:00:00Z","end":"2030-01-01T10:00:00Z","owner":"Alice"},"expect":{"status":400}},{"path":"/api/bookings","method":"POST","body":{"room":"A","start":"2030-01-01T10:30:00Z","end":"2030-01-01T11:30:00Z","owner":"Bob"},"expect":{"status":409}}]},
    {"id":"adjacent_times","steps":[{"path":"/api/bookings","method":"POST","body":{"room":"A","start":"2030-01-01T11:00:00Z","end":"2030-01-01T12:00:00Z","owner":"Bob"},"expect":{"status":201}},{"path":"/api/bookings","method":"POST","body":{"room":"B","start":"2030-01-01T10:00:00Z","end":"2030-01-01T11:00:00Z","owner":"Carol"},"expect":{"status":201}}]},
    {"id":"concurrent_conflict","steps":[{"parallel":[{"path":"/api/bookings","method":"POST","body":{"room":"C","start":"2030-01-01T10:00:00Z","end":"2030-01-01T11:00:00Z","owner":"Alice"}},{"path":"/api/bookings","method":"POST","body":{"room":"C","start":"2030-01-01T10:00:00Z","end":"2030-01-01T11:00:00Z","owner":"Bob"}}],"statuses":[201,409]},{"path":"/api/bookings","expect":{"status":200,"length":4}}]},
    {"id":"delete_permissions","steps":[{"path":"/api/bookings/${booking}","method":"DELETE","expect":{"status":401}},{"path":"/api/bookings/${booking}","method":"DELETE","headers":{"Authorization":"Bearer staff"},"expect":{"status":403}},{"path":"/api/bookings/${booking}","method":"DELETE","headers":{"Authorization":"Bearer admin"},"expect":{"status":204}},{"path":"/api/bookings/${booking}","method":"DELETE","headers":{"Authorization":"Bearer admin"},"expect":{"status":404}}]},
    {"id":"persistence","steps":[{"restart":true},{"path":"/api/bookings","expect":{"status":200,"length":3,"fields":{"0.room":"A","0.owner":"Bob","0.start":"2030-01-01T11:00:00Z"}}}]}
  ],
  "browser": [{"id":"ui_booking","steps":[{"fill":"#room","value":"浏览器会议室"},{"fill":"#start","value":"2030-02-01T09:00:00Z"},{"fill":"#end","value":"2030-02-01T10:00:00Z"},{"fill":"#owner","value":"讲师"},{"click":"#book"},{"text":"#bookings","contains":"浏览器会议室"},{"reload":true},{"text":"#bookings","contains":"浏览器会议室"}]}]
}
