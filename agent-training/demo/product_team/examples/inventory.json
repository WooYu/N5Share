{
  "name": "库存与领用管理",
  "requirements": "从空目录实现库存领用产品。Python标准库与SQLite。库存初始为空；GET /api/items 返回按id升序的数组，每项id整数、name字符串、stock非负整数。POST /api/items {name,stock} 仅Authorization: Bearer manager可新增，201返回该对象；未登录401，其他角色403，空名称、非整数、负库存400。POST /api/withdrawals {item_id,quantity} 要求Bearer staff或manager；Idempotency-Key为必填请求号；201返回{id整数,item_id整数,quantity整数}。同一请求号和同一内容重试200返回原对象且不再次扣库，重复号不同内容409。数量必须正整数；库存不足409，商品不存在404。事务保证并发扣减不超卖。所有数据重启保留。测试角色是本地演练身份，非生产用户认证。前端有商品名#name、库存#stock、添加按钮#add、列表#items；领用输入#item-id和#quantity、按钮#withdraw、提示#error；页面提供manager/staff身份选择#role，默认manager；新增成功列表立即刷新。领用按钮每次点击产生唯一请求号，失败显示具体原因。页面标题包含库存，库存列表展示名称与余量。README写运行、测试身份、数据库初始化、备份和回滚。",
  "unresolved": [],
  "acceptance": [
    {"id":"empty_and_frontend","steps":[{"path":"/","expect":{"status":200,"contains":["库存","id=\"name\"","id=\"stock\"","id=\"add\""]}},{"path":"/api/items","expect":{"status":200,"equals":[]}}]},
    {"id":"permissions","steps":[{"path":"/api/items","method":"POST","body":{"name":"纸张","stock":3},"expect":{"status":401}},{"path":"/api/items","method":"POST","headers":{"Authorization":"Bearer staff"},"body":{"name":"纸张","stock":3},"expect":{"status":403}}]},
    {"id":"create_inventory","steps":[{"path":"/api/items","method":"POST","headers":{"Authorization":"Bearer manager"},"body":{"name":"纸张","stock":3},"expect":{"status":201,"fields":{"name":"纸张","stock":3},"types":{"id":"integer","name":"string","stock":"integer"}},"save":{"item":"id"}},{"path":"/api/items","method":"POST","headers":{"Authorization":"Bearer manager"},"body":{"name":"非法","stock":-1},"expect":{"status":400}}]},
    {"id":"idempotent_withdrawal","steps":[{"path":"/api/withdrawals","method":"POST","headers":{"Authorization":"Bearer staff","Idempotency-Key":"request-a"},"body":{"item_id":"${item}","quantity":1},"expect":{"status":201,"fields":{"item_id":"${item}","quantity":1},"types":{"id":"integer"}},"save":{"withdrawal":"id"}},{"path":"/api/withdrawals","method":"POST","headers":{"Authorization":"Bearer staff","Idempotency-Key":"request-a"},"body":{"item_id":"${item}","quantity":1},"expect":{"status":200,"fields":{"id":"${withdrawal}"}}},{"path":"/api/withdrawals","method":"POST","headers":{"Authorization":"Bearer staff","Idempotency-Key":"request-a"},"body":{"item_id":"${item}","quantity":2},"expect":{"status":409}},{"path":"/api/items","expect":{"status":200,"fields":{"0.stock":2}}}]},
    {"id":"invalid_withdrawal","steps":[{"path":"/api/withdrawals","method":"POST","headers":{"Authorization":"Bearer staff","Idempotency-Key":"invalid"},"body":{"item_id":"${item}","quantity":0},"expect":{"status":400}},{"path":"/api/withdrawals","method":"POST","headers":{"Authorization":"Bearer staff","Idempotency-Key":"missing"},"body":{"item_id":999999,"quantity":1},"expect":{"status":404}}]},
    {"id":"no_overselling","steps":[{"parallel":[{"path":"/api/withdrawals","method":"POST","headers":{"Authorization":"Bearer staff","Idempotency-Key":"race-a"},"body":{"item_id":"${item}","quantity":2}},{"path":"/api/withdrawals","method":"POST","headers":{"Authorization":"Bearer staff","Idempotency-Key":"race-b"},"body":{"item_id":"${item}","quantity":2}}],"statuses":[201,409]},{"path":"/api/items","expect":{"status":200,"fields":{"0.stock":0},"length":1}}]},
    {"id":"persistence","steps":[{"restart":true},{"path":"/api/items","expect":{"status":200,"fields":{"0.id":"${item}","0.stock":0,"0.name":"纸张"}}}]}
  ],
  "browser": [{"id":"ui_inventory","steps":[{"fill":"#name","value":"浏览器商品"},{"fill":"#stock","value":"7"},{"click":"#add"},{"text":"#items","contains":"浏览器商品"},{"reload":true},{"text":"#items","contains":"浏览器商品"}]}]
}
